[application]

config/name="WebGPU Backend Test"
config/description="Testing Godot's WebGPU rendering backend implementation"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Web")
config/icon="res://icon.svg"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.web="webgpu"
textures/canvas_textures/default_texture_filter=2

[debug]

gdscript/warnings/enable=true
gdscript/warnings/unused_variable=false
gdscript/warnings/unused_local_constant=false
gdscript/warnings/unused_private_class_variable=false
gdscript/warnings/unused_parameter=false
gdscript/warnings/unused_signal=false

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true

[input]

ui_accept={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194309,"physical_keycode":0,"key_label":0,"unicode":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":4194310,"physical_keycode":0,"key_label":0,"unicode":0,"echo":false,"script":null)
, Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":32,"physical_keycode":0,"key_label":0,"unicode":32,"echo":false,"script":null)
]
}

[web]

variant/thread_support=false
variant/experimental_features_enabled=true
